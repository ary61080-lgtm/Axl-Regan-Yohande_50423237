<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 1. Bean DataSource Koneksi MySQL XAMPP -->
    <bean id="dataSource" class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver"/>
        <property name="url" value="jdbc:mysql://localhost:3306/db_pengadaan_sekolah?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Jakarta"/>
        <property name="username" value="root"/>
        <property name="password" value=""/>
    </bean>

    <!-- 2. Bean JdbcTemplate Spring -->
    <bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <!-- 3. Bean Spring DAO -->
    <bean id="pesananSpringDao" class="com.mycompany.cobamvc.PesananSpringDao">
        <property name="jdbcTemplate" ref="jdbcTemplate"/>
    </bean>

</beans>
