<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="LaporanSalesOrder"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="36"
              bottomMargin="36"
              uuid="7a4e5b90-12ab-4cde-9012-abcdef123456">

    <parameter name="NAMA_PERUSAHAAN" class="java.lang.String"/>
    <parameter name="DIREKTUR" class="java.lang.String"/>
    <parameter name="TANGGAL_CETAK" class="java.lang.String"/>
    <parameter name="FILTER_PESANAN" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[SELECT
            nomor_pesanan,
            nama_sekolah,
            DATE_FORMAT(tanggal_pesanan, '%Y-%m-%d') AS tanggal_pesanan,
            total,
            status_pengiriman
        FROM pesanan
        WHERE ($P{FILTER_PESANAN} IS NULL OR $P{FILTER_PESANAN} = '' OR nomor_pesanan = $P{FILTER_PESANAN})
        ORDER BY tanggal_pesanan DESC, nomor_pesanan DESC]]>
    </queryString>

    <field name="nomor_pesanan" class="java.lang.String"/>
    <field name="nama_sekolah" class="java.lang.String"/>
    <field name="tanggal_pesanan" class="java.lang.String"/>
    <field name="total" class="java.lang.Double"/>
    <field name="status_pengiriman" class="java.lang.String"/>

    <variable name="SUM_TOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>
    <variable name="JUMLAH_BARIS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{nomor_pesanan}]]></variableExpression>
    </variable>

    <title>
        <band height="92" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="58" backcolor="#0F172A" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="14" y="8" width="487" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{NAMA_PERUSAHAAN}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="14" y="32" width="487" height="18" forecolor="#CBD5E1"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="false"/>
                </textElement>
                <text><![CDATA[LAPORAN REKAPITULASI SALES ORDER PENGADAAN SEKOLAH (DANA BOS)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="66" width="300" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Direktur: " + $P{DIREKTUR}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="66" width="215" height="18" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Tanggal Cetak: " + $P{TANGGAL_CETAK}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="88" width="515" height="1" forecolor="#1D4ED8"/>
                <graphicElement><pen lineWidth="1.5" lineColor="#1D4ED8"/></graphicElement>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="26" backcolor="#1E293B" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#1E293B"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="0" width="28" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[No]]></text>
            </staticText>
            <staticText>
                <reportElement x="34" y="0" width="90" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[No. Pesanan]]></text>
            </staticText>
            <staticText>
                <reportElement x="126" y="0" width="155" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Sekolah Penerima]]></text>
            </staticText>
            <staticText>
                <reportElement x="283" y="0" width="70" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Tanggal]]></text>
            </staticText>
            <staticText>
                <reportElement x="355" y="0" width="92" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Nilai]]></text>
            </staticText>
            <staticText>
                <reportElement x="451" y="0" width="60" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="24" backcolor="#FFFFFF" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="4" y="0" width="28" height="24" forecolor="#0F172A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="34" y="0" width="90" height="24" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{nomor_pesanan}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="126" y="0" width="155" height="24" forecolor="#334155"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{nama_sekolah}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="283" y="0" width="70" height="24" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{tanggal_pesanan}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="0" width="92" height="24" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Rp " + new java.text.DecimalFormat("#,##0").format($F{total} != null ? $F{total} : 0)]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="451" y="0" width="60" height="24" forecolor="#1D4ED8"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status_pengiriman}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="115" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="10" width="515" height="28" backcolor="#F1F5F9" mode="Opaque"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#94A3B8"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="12" y="10" width="250" height="28" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total Transaksi: " + ($V{JUMLAH_BARIS} != null ? $V{JUMLAH_BARIS} : 0) + " Pesanan"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="265" y="10" width="238" height="28" forecolor="#15803D"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Grand Total: Rp " + new java.text.DecimalFormat("#,##0").format($V{SUM_TOTAL} != null ? $V{SUM_TOTAL} : 0)]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="320" y="52" width="195" height="16" forecolor="#334155"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement>
                <text><![CDATA[Mengetahui / Disetujui Oleh,]]></text>
            </staticText>
            <textField>
                <reportElement x="320" y="92" width="195" height="18" forecolor="#0F172A"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{DIREKTUR} + " (Direktur)"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
